# Exemplo de .env para EKS (AWS Academy / LabRole) - Fase 2
# Copie para .env na raiz e ajuste o que for específico do seu lab.
# Depois:
#   ./scripts/render-k8s-manifests.sh
#   ./scripts/k8s-apply.sh
#
# Região: us-east-1

AWS_REGION=us-east-1

# -------- ECR (prefixos) — Account ID do sts get-caller-identity --------
AWS_AUTH_SERVICE_ECR=905418013072.dkr.ecr.us-east-1.amazonaws.com/
AWS_FLAG_SERVICE_ECR=905418013072.dkr.ecr.us-east-1.amazonaws.com/
AWS_TARGETING_SERVICE_ECR=905418013072.dkr.ecr.us-east-1.amazonaws.com/
AWS_EVALUATION_SERVICE_ECR=905418013072.dkr.ecr.us-east-1.amazonaws.com/
AWS_ANALYTICS_SERVICE_ECR=905418013072.dkr.ecr.us-east-1.amazonaws.com/

# -------- SQS / DynamoDB (AWS) --------
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/905418013072/fiap-evaluation-events
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# -------- ElastiCache Redis (AWS) — só hostname, sem redis:// --------
ELASTICACHE_ENDPOINT=seu-endpoint.cache.amazonaws.com

# -------- RDS Postgres (AWS) — endpoints reais do console ou describe-db-instances --------
RDS_AUTH_ENDPOINT=fiap-auth-db.c9mcos82gnn7.us-east-1.rds.amazonaws.com
RDS_AUTH_DB=auth_db
RDS_AUTH_USER=auth_user
RDS_AUTH_PASSWORD=auth_password

RDS_FLAG_ENDPOINT=fiap-flag-db.c9mcos82gnn7.us-east-1.rds.amazonaws.com
RDS_FLAG_DB=flag_db
RDS_FLAG_USER=flag_user
RDS_FLAG_PASSWORD=flag_password

RDS_TARGETING_ENDPOINT=fiap-targeting-db.c9mcos82gnn7.us-east-1.rds.amazonaws.com
RDS_TARGETING_DB=targeting_db
RDS_TARGETING_USER=targeting_user
RDS_TARGETING_PASSWORD=targeting_password

# -------- Auth / Evaluation --------
MASTER_KEY=admin-secreto-123
# Gere no cluster (POST /auth/admin/keys) e cole aqui antes de re-renderizar secrets.
SERVICE_API_KEY=substitua-pela-chave-real
