# Exemplo de .env para EKS (AWS Academy / LabRole) - Fase 2
# Use este arquivo como base para preencher e depois rodar:
#   ./scripts/render-k8s-manifests.sh
#   ./scripts/k8s-apply.sh
#
# Recomendado: mantenha tudo em us-east-1

AWS_REGION=us-east-1

# -------- ECR (prefixos) --------
# Formato:
#   <ACCOUNT_ID>.dkr.ecr.<REGIAO>.amazonaws.com/
AWS_AUTH_SERVICE_ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com/
AWS_FLAG_SERVICE_ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com/
AWS_TARGETING_SERVICE_ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com/
AWS_EVALUATION_SERVICE_ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com/
AWS_ANALYTICS_SERVICE_ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com/

# -------- SQS / DynamoDB (AWS) --------
# SQS queue URL (evaluation produz / analytics consome)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/fiap-evaluation-events

# DynamoDB
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# -------- ElastiCache Redis (AWS) --------
# Endpoint do cluster Redis (sem "redis://", só host)
ELASTICACHE_ENDPOINT=seu-endpoint.cache.amazonaws.com

# -------- RDS Postgres (AWS) --------
RDS_AUTH_ENDPOINT=seu-auth.xxxxx.us-east-1.rds.amazonaws.com
RDS_AUTH_DB=auth_db
RDS_AUTH_USER=auth_user
RDS_AUTH_PASSWORD=auth_password

RDS_FLAG_ENDPOINT=seu-flag.xxxxx.us-east-1.rds.amazonaws.com
RDS_FLAG_DB=flag_db
RDS_FLAG_USER=flag_user
RDS_FLAG_PASSWORD=flag_password

RDS_TARGETING_ENDPOINT=seu-targeting.xxxxx.us-east-1.rds.amazonaws.com
RDS_TARGETING_DB=targeting_db
RDS_TARGETING_USER=targeting_user
RDS_TARGETING_PASSWORD=targeting_password

# -------- Auth / Evaluation --------
# Master key do auth-service (você define; use no curl /admin/keys no cluster)
MASTER_KEY=admin-secreto-123

# Service API Key: será gerada no cluster (POST /auth/admin/keys) e colada aqui depois.
SERVICE_API_KEY=substitua-pela-chave-real

