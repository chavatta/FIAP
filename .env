# Copiado de .env.example (auto-gerado)
# Server ports (mapeados no host)
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# Master key do auth-service (admin/keys)
MASTER_KEY=admin-secreto-123

# Endpoints internos (dentro do docker-compose network)
AUTH_SERVICE_URL=http://auth-service:8001
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003

# Redis local (usado pelo evaluation-service)
REDIS_URL=redis://redis:6379

# SQS é opcional no demo local do PDF.
AWS_SQS_URL=
AWS_REGION=us-east-1

# DynamoDB (local) - nome da tabela esperada
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# API key que o evaluation-service usa para chamar flag/targeting.
# IMPORTANTE: vamos substituir pelo valor REAL gerado no auth-service.
SERVICE_API_KEY=tm_key_01f9ad48159e9ad882b8b4411be86d4addf5eb418b4027f140b1525880b9269e

# PostgreSQL 1 (compartilhado por auth-service + flag-service)
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_password
AUTH_DATABASE_URL=postgres://auth_user:auth_password@auth-flag-db:5432/auth_db

# PostgreSQL 2 (targeting-service)
TARGETING_POSTGRES_DB=targeting_db
TARGETING_POSTGRES_USER=targeting_user
TARGETING_POSTGRES_PASSWORD=targeting_password
TARGETING_DATABASE_URL=postgres://targeting_user:targeting_password@targeting-service-db:5432/targeting_db

# Credenciais AWS (opcional no demo local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

