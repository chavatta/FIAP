# Exemplo de .env para docker-compose (stack local do PDF).
# Para EKS na AWS, use .env.eks.example como base e copie para .env.

# -------- Portas (host) --------
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

MASTER_KEY=admin-secreto-123

AUTH_SERVICE_URL=http://auth-service:8001
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003

REDIS_URL=redis://redis:6379

AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# SQS opcional no compose local (vazio = worker SQS desligado no analytics)
# AWS_SQS_URL=

# Chave criada no auth (POST /admin/keys); substitua após gerar
SERVICE_API_KEY=chave_secreta

AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_password
AUTH_DATABASE_URL=postgres://auth_user:auth_password@auth-flag-db:5432/auth_db

TARGETING_POSTGRES_DB=targeting_db
TARGETING_POSTGRES_USER=targeting_user
TARGETING_POSTGRES_PASSWORD=targeting_password
TARGETING_DATABASE_URL=postgres://targeting_user:targeting_password@targeting-service-db:5432/targeting_db

# Credenciais AWS (opcional no demo local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -------- ECR / EKS (make push, render-k8s) — ver .env.eks.example --------
# AWS_AUTH_SERVICE_ECR=ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/
# ...
